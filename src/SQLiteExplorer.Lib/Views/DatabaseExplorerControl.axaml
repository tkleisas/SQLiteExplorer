<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLiteExplorer.Lib.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:grid="clr-namespace:AvaloniaVirtualDataGrid.Controls;assembly=AvaloniaVirtualDataGrid"
        xmlns:views="clr-namespace:SQLiteExplorer.Lib.Views"
        xmlns:AvaloniaEdit="using:AvaloniaEdit"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:behaviors="using:SQLiteExplorer.Lib.Behaviors"
        xmlns:converters="using:SQLiteExplorer.Lib.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SQLiteExplorer.Lib.Views.DatabaseExplorerControl"
        x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converters:HasErrorToColorConverter x:Key="HasErrorToColorConverter"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="TextBlock.panelHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              IsVisible="{Binding IsMenuVisible}">
            <MenuItem Header="_File">
                <MenuItem Header="_New">
                    <MenuItem Header="SQLite Database..." Command="{Binding NewSqliteDatabaseCommand}"/>
                    <MenuItem Header="PostgreSQL Database..." Command="{Binding OpenPostgresDatabaseCommand}"/>
                    <MenuItem Header="SQL Server Database..." Command="{Binding OpenSqlServerDatabaseCommand}"/>
                    <MenuItem Header="Oracle Database..." Command="{Binding OpenOracleDatabaseCommand}"/>
                </MenuItem>
                <MenuItem Header="_Open">
                    <MenuItem Header="SQLite Database..." Command="{Binding OpenSqliteDatabaseCommand}"/>
                    <MenuItem Header="PostgreSQL Database..." Command="{Binding OpenPostgresDatabaseCommand}"/>
                    <MenuItem Header="SQL Server Database..." Command="{Binding OpenSqlServerDatabaseCommand}"/>
                    <MenuItem Header="Oracle Database..." Command="{Binding OpenOracleDatabaseCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh Tree" Command="{Binding RefreshDatabaseTreeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Query">
                <MenuItem Header="_New Query Tab" Command="{Binding AddNewQueryTabCommand}"/>
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="_Reports..." Command="{Binding OpenReportsCommand}"/>
                <MenuItem Header="_New Report (Wizard)..." Command="{Binding NewReportCommand}"/>
            </MenuItem>
            <MenuItem Header="_AI">
                <MenuItem Header="_Ask AI..." Command="{Binding ShowAiAssistantCommand}"/>
                <MenuItem Header="AI _Complete at Cursor" Command="{Binding AiCompleteCommand}" HotKey="Ctrl+Shift+Space"/>
                <Separator/>
                <MenuItem Header="_Explain Query" Command="{Binding ExplainQueryCommand}"/>
                <MenuItem Header="_Optimize Query" Command="{Binding OptimizeQueryCommand}"/>
                <MenuItem Header="Analyze _Results" Command="{Binding AnalyzeResultsCommand}"/>
                <Separator/>
                <MenuItem Header="AI _Settings..." Command="{Binding OpenLlmSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="SQLite _Cheatsheet" Command="{Binding ShowSqliteCheatsheetCommand}"/>
                <MenuItem Header="PostgreSQL _Cheatsheet" Command="{Binding ShowPostgresCheatsheetCommand}"/>
                <MenuItem Header="SQL _Server Cheatsheet" Command="{Binding ShowSqlServerCheatsheetCommand}"/>
                <MenuItem Header="_Oracle Cheatsheet" Command="{Binding ShowOracleCheatsheetCommand}"/>
                <Separator/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>
        
        <Grid Grid.Row="1" ColumnDefinitions="250,6,*,6,380">
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Database Explorer" Classes="panelHeader" Margin="10,8"/>
                    <TreeView Grid.Row="1" Name="DatabaseTreeView" ItemsSource="{Binding DatabaseNodes}" Margin="5,0">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="SELECT *" 
                                                      Command="{Binding $parent[views:DatabaseExplorerControl].((vm:MainWindowViewModel)DataContext).SelectTableCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsVisible="{ReflectionBinding IsTableOrView}"/>
                                            <MenuItem Header="DESCRIBE TABLE" 
                                                      Command="{Binding $parent[views:DatabaseExplorerControl].((vm:MainWindowViewModel)DataContext).DescribeTableCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsVisible="{ReflectionBinding IsTableOrView}"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="12" Padding="10,4" VerticalAlignment="Center"
                                IsVisible="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🗄" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectionDisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="tool" Command="{Binding AddNewQueryTabCommand}" ToolTip.Tip="New Query (Ctrl+T)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="➕" VerticalAlignment="Center"/>
                                <TextBlock Text="New Query" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="accent" Command="{Binding SelectedTab.ExecuteQueryCommand}" 
                                AutomationProperties.AutomationId="ExecuteQueryButton"
                                IsEnabled="{Binding !SelectedTab.IsLoading}"
                                ToolTip.Tip="Execute Query (Ctrl+Enter)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="▶" VerticalAlignment="Center"/>
                                <TextBlock Text="Execute" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Command="{Binding ShowAiAssistantCommand}" ToolTip.Tip="AI Assistant">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✨" VerticalAlignment="Center"/>
                                <TextBlock Text="AI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding QueryHistory}"
                              SelectedItem="{Binding SelectedHistoryItem}"
                              PlaceholderText="History"
                              Width="140"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Query History"/>
                </Grid>
                
                <TabControl Grid.Row="1"
                            ItemsSource="{Binding QueryTabs}" 
                            SelectedItem="{Binding SelectedTab}" Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </TabControl.Styles>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="vm:QueryTabViewModel">
                            <DockPanel Margin="0">
                                <Button DockPanel.Dock="Right" Classes="flat"
                                        Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseQueryTabCommand}"
                                        CommandParameter="{Binding}"
                                        Width="16" Height="16" Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="×" FontSize="11" Foreground="Gray"/>
                                </Button>
                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="vm:QueryTabViewModel">
                            <Grid RowDefinitions="*,Auto,*">
                                <Border Grid.Row="0" Margin="8,8,8,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <AvaloniaEdit:TextEditor ShowLineNumbers="True"
                                                             AutomationProperties.AutomationId="QueryEditor"
                                                             FontFamily="Consolas, Courier New"
                                                             FontSize="14"
                                                             SyntaxHighlighting="SQL"
                                                             Background="#1E1E1E"
                                                             Foreground="#D4D4D4"
                                                             behaviors:SqlCompletionBehavior.Provider="{Binding $parent[views:DatabaseExplorerControl].((vm:MainWindowViewModel)DataContext).CompletionProvider}"
                                                             behaviors:SqlCompletionBehavior.AiCompleteCommand="{Binding $parent[views:DatabaseExplorerControl].((vm:MainWindowViewModel)DataContext).AiCompleteCommand}"
                                                             behaviors:EditorAdapterBehavior.Tab="{ReflectionBinding}">
                                        <i:Interaction.Behaviors>
                                            <behaviors:DocumentTextBindingBehavior Text="{ReflectionBinding SqlText, Mode=TwoWay}"/>
                                        </i:Interaction.Behaviors>
                                    </AvaloniaEdit:TextEditor>
                                </Border>
                                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0"/>
                                <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="8,0,8,8">
                                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4" CornerRadius="4,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding ResultStatus}" FontFamily="Consolas, Courier New" FontSize="12"
                                                       Foreground="{Binding HasError, Converter={StaticResource HasErrorToColorConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <TabControl Grid.Row="1" ItemsSource="{Binding ResultSets}" SelectedItem="{Binding SelectedResultSet}"
                                                Padding="0" Margin="0,4,0,0">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ResultSetViewModel">
                                                <TextBlock Text="{Binding Title}" FontSize="11"/>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate DataType="vm:ResultSetViewModel">
                                                <Grid RowDefinitions="Auto,*">
                                                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Status}" FontFamily="Consolas, Courier New" FontSize="12"
                                                                       Foreground="{Binding HasError, Converter={StaticResource HasErrorToColorConverter}}"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                <Button Content="CSV" Classes="chip"
                                                                        Command="{Binding ExportCsvCommand}"/>
                                                                <Button Content="JSON" Classes="chip"
                                                                        Command="{Binding ExportJsonCommand}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <views:QueryResultsView Grid.Row="1" DataContext="{ReflectionBinding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                
                <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding IsConnected, Converter={x:Static vm:MainWindowViewModel.ConnectedBrushConverter}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding CurrentDatabaseType}" Margin="8,0"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding IsConnected, Converter={x:Static vm:MainWindowViewModel.ConnectedConverter}}" 
                                   Foreground="{Binding IsConnected, Converter={x:Static vm:MainWindowViewModel.ConnectedBrushConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
            
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          IsVisible="{Binding Cheatsheet.IsVisible}"/>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          IsVisible="{Binding AiAssistant.IsVisible}"/>
            
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Cheatsheet.IsVisible, Converter={x:Static converters:BoolToGridLengthConverter.Instance}}" />
                    <RowDefinition Height="{Binding AiAssistant.IsVisible, Converter={x:Static converters:BoolToGridLengthConverter.Instance}}" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                    IsVisible="{Binding Cheatsheet.IsVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Cheatsheet.Title}" Classes="panelHeader"/>
                            <Button Grid.Column="1" Classes="flat" Command="{Binding CloseCheatsheetCommand}"
                                    Width="20" Height="20">
                                <TextBlock Text="×" FontSize="14" Foreground="Gray"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <TextBox Text="{Binding Cheatsheet.Content}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                    IsVisible="{Binding AiAssistant.IsVisible}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="✨ AI Assistant" Classes="panelHeader"/>
                            <Button Grid.Column="1" Classes="flat" Command="{Binding OpenLlmSettingsCommand}"
                                    Width="24" Height="20" ToolTip.Tip="AI Settings">
                                <TextBlock Text="⚙" FontSize="13" Foreground="Gray"/>
                            </Button>
                            <Button Grid.Column="2" Classes="flat" Command="{Binding CloseAiAssistantCommand}"
                                    Width="20" Height="20">
                                <TextBlock Text="×" FontSize="14" Foreground="Gray"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="8,8,8,0" IsVisible="{Binding !LlmService.IsConfigured}">
                        <TextBlock Text="LLM is not configured. Click ⚙ to set up an endpoint, then ask questions in natural language or analyze queries and results."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                    </Border>

                    <Border Grid.Row="2" Padding="8">
                        <TextBox AutomationProperties.AutomationId="AiQuestionInput"
                                 Text="{Binding AiAssistant.Question}"
                                 PlaceholderText="Ask about your data, e.g. &quot;top 10 products by price&quot;"
                                 AcceptsReturn="True"
                                 MinHeight="56"
                                 TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="3" Padding="8,0,8,8">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <Button Grid.Row="0" Grid.Column="0" Classes="chip" Content="Generate SQL"
                                    AutomationProperties.AutomationId="AiGenerateSqlButton"
                                    Command="{Binding AiAssistant.AskCommand}" Margin="0,0,4,4"
                                    ToolTip.Tip="Generate SQL from your question"/>
                            <Button Grid.Row="0" Grid.Column="1" Classes="chip" Content="Explain Query"
                                    Command="{Binding ExplainQueryCommand}" Margin="4,0,0,4"
                                    ToolTip.Tip="Explain the current query"/>
                            <Button Grid.Row="1" Grid.Column="0" Classes="chip" Content="Optimize Query"
                                    Command="{Binding OptimizeQueryCommand}" Margin="0,4,4,0"
                                    ToolTip.Tip="Suggest optimizations for the current query"/>
                            <Button Grid.Row="1" Grid.Column="1" Classes="chip" Content="Analyze Results"
                                    Command="{Binding AnalyzeResultsCommand}" Margin="4,4,0,0"
                                    ToolTip.Tip="Summarize the selected result set"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" Margin="8,0">
                        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4"
                                     Margin="0,4"
                                     IsVisible="{Binding AiAssistant.IsBusy}"/>
                        <TextBlock Grid.Row="1" Text="{Binding AiAssistant.ErrorMessage}"
                                   Foreground="Red" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                   IsVisible="{Binding AiAssistant.HasError}"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer>
                                <TextBox Text="{Binding AiAssistant.Response}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Margin="8"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="5" Padding="8">
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" Classes="chip" Content="Insert SQL into editor"
                                    AutomationProperties.AutomationId="AiInsertSqlButton"
                                    Command="{Binding InsertAiSqlCommand}" Margin="0,0,4,0"
                                    ToolTip.Tip="Insert the SQL from the response at the caret"/>
                            <Button Grid.Column="1" Classes="chip" Content="Clear"
                                    Command="{Binding AiAssistant.ClearCommand}" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
