<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SQLiteExplorer.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Xaml.Behaviors.Interactivity" Version="12.0.0.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- 2.19.x (ODP.NET Core 19c) is the newest line that still supports connecting
         to Oracle Database 11g Release 2; 21c floors at 12.1 and 23.x at 19c. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="2.19.310" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\lib\AvaloniaVirtualDataGrid\src\AvaloniaVirtualDataGrid\AvaloniaVirtualDataGrid.csproj" />
  </ItemGroup>
</Project>
