<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLiteExplorer.Lib.ViewModels"
        xmlns:views="using:SQLiteExplorer.Lib.Views"
        x:Class="SQLiteExplorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1200" Height="800">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <views:DatabaseExplorerControl DataContext="{Binding}"/>
</Window>
