<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SQLiteExplorer.Views.AboutWindow"
        Title="About SQLite Explorer"
        Width="420"
        Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" FontSize="24" FontWeight="Bold" Text="SQLite Explorer"/>
        
        <TextBlock Grid.Row="1" x:Name="VersionText" Margin="0,8,0,0" FontSize="14" Foreground="Gray"/>
        
        <Separator Grid.Row="2" Margin="0,16"/>
        
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Platform:" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlatformText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            
            <TextBlock Text="Runtime:" FontWeight="SemiBold"/>
            <TextBlock x:Name="RuntimeText" TextWrapping="Wrap"/>
        </StackPanel>
        
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="12" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock Text="Credits" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock>
                    <Run Text="Designer:" FontWeight="Medium"/> tkleisas
                </TextBlock>
                <TextBlock>
                    <Run Text="Software Engineer:" FontWeight="Medium"/> AI SLOPTRONIC (TM) / Claude
                </TextBlock>
            </StackPanel>
        </Border>
        
        <Button Grid.Row="5" Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0" 
                Padding="24,8" Click="OnCloseClick"/>
    </Grid>
</Window>
